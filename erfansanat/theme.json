{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "820px",
			"wideSize": "1300px"
		},
		"color": {
			"custom": false,
			"customDuotone": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "brand", "color": "#00a83e", "name": "سبز عرفان" },
				{ "slug": "brand-dark", "color": "#047857", "name": "سبز تیره" },
				{ "slug": "ink", "color": "#0f172a", "name": "متن اصلی" },
				{ "slug": "muted", "color": "#64748b", "name": "متن کم‌رنگ" },
				{ "slug": "line", "color": "#e2e8f0", "name": "خط جداکننده" },
				{ "slug": "surface", "color": "#f6f8f7", "name": "پس‌زمینهٔ روشن" },
				{ "slug": "white", "color": "#ffffff", "name": "سفید" }
			]
		},
		"typography": {
			"customFontSize": false,
			"dropCap": false,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "vazirmatn",
					"name": "وزیرمتن",
					"fontFamily": "\"Vazirmatn\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Tahoma, sans-serif"
				},
				{
					"slug": "mono",
					"name": "مونواسپیس",
					"fontFamily": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.8125rem", "name": "کوچک" },
				{ "slug": "medium", "size": "0.9375rem", "name": "معمولی" },
				{ "slug": "large", "size": "1.125rem", "name": "بزرگ" },
				{ "slug": "x-large", "size": "1.5rem", "name": "خیلی بزرگ" },
				{ "slug": "xx-large", "size": "2rem", "name": "عنوان" }
			]
		},
		"spacing": {
			"customSpacingSize": false,
			"units": [ "px", "rem", "%" ],
			"spacingSizes": [
				{ "slug": "10", "size": "0.625rem", "name": "۱" },
				{ "slug": "20", "size": "1.25rem", "name": "۲" },
				{ "slug": "30", "size": "1.875rem", "name": "۳" },
				{ "slug": "40", "size": "2.5rem", "name": "۴" },
				{ "slug": "50", "size": "3.75rem", "name": "۵" }
			]
		},
		"border": { "radius": true },
		"shadow": { "defaultPresets": false },
		"custom": {
			"line-height": {
				"default": 1.85,
				"heading": 1.3
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--vazirmatn)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.85"
		},
		"spacing": {
			"blockGap": "1.25rem"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "800",
					"lineHeight": "1.3"
				},
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--brand-dark)" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--brand)" }
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--brand-dark)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": { "radius": "0.75rem" },
				"typography": { "fontWeight": "800", "fontSize": "0.8125rem" },
				"spacing": {
					"padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.25rem", "right": "1.25rem" }
				}
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--muted)" },
				"typography": { "fontSize": "0.8125rem" }
			}
		},
		"blocks": {
			"core/quote": {
				"border": { "radius": "1rem" },
				"spacing": { "padding": { "top": "1.25rem", "bottom": "1.25rem", "left": "1.5rem", "right": "1.5rem" } },
				"color": { "background": "var(--wp--preset--color--surface)" }
			},
			"core/table": {
				"typography": { "fontSize": "0.875rem" }
			},
			"core/code": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--mono)" }
			}
		}
	},
	"templateParts": [],
	"customTemplates": []
}
