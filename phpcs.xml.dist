<?xml version="1.0"?>
<ruleset name="ErfanSanatTheme">
	<description>Coding standard for the Erfan Sanat theme: WordPress core style with PSR-4 class file names.</description>

	<file>erfansanat</file>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<arg name="colors"/>

	<rule ref="WordPress"/>

	<!-- The architecture intentionally uses PSR-4 file names (inc/Autoloader.php). -->
	<rule ref="WordPress.Files.FileName">
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="erfansanat"/>
				<element value="ERFANSANAT"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="erfansanat"/>
			</property>
		</properties>
	</rule>
</ruleset>
