# Persian (fa_IR) additions for the WooCommerce storefront screens.
#
# The Persian catalogue shipped with WooCommerce (Persian-WooCommerce on
# translate.wordpress.org) does not yet cover the block-cart/checkout screens or
# several account strings, so those pages fall back to English on a Persian
# store. This file holds only the strings the theme's own screens actually
# render; tools/patch-woocommerce-translations.php merges them into the
# installed catalogue. Nothing here overrides an existing translation.
msgid ""
msgstr ""
"Language: fa_IR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Domain: woocommerce\n"

